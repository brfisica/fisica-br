import numpy as np
import matplotlib.pyplot as plt
from ipywidgets import FloatSlider, VBox, interactive_output
from IPython.display import display, Markdown

def simulacion(distancia=120.0, tiempo_reaccion=15.0, velocidad=1.2):
    if distancia <= 0 or tiempo_reaccion < 0 or velocidad <= 0:
        print("Usa distancia y velocidad mayores que cero.")
        return

    tiempo_movimiento = distancia / velocidad
    tiempo_total = tiempo_reaccion + tiempo_movimiento

    t = np.linspace(0, tiempo_total, 500)

    posicion = np.where(
        t < tiempo_reaccion,
        0,
        velocidad * (t - tiempo_reaccion)
    )

    velocidad_t = np.where(
        t < tiempo_reaccion,
        0,
        velocidad
    )

    posicion = np.minimum(posicion, distancia)

    print(f"Distancia: {distancia:.2f} m")
    print(f"Tiempo de reacción: {tiempo_reaccion:.2f} s")
    print(f"Velocidad de desplazamiento: {velocidad:.2f} m/s")
    print(f"Tiempo de movimiento: {tiempo_movimiento:.2f} s")
    print(f"Tiempo total: {tiempo_total:.2f} s")
    print(f"Tiempo total: {tiempo_total/60:.2f} min")

    fig, axes = plt.subplots(1, 2, figsize=(13, 4.5))

    axes[0].plot(t, posicion, color="royalblue", linewidth=2.5)
    axes[0].axvline(
        tiempo_reaccion,
        color="darkorange",
        linestyle="--",
        label="Inicio del movimiento"
    )
    axes[0].axhline(
        distancia,
        color="green",
        linestyle=":",
        label="Punto seguro"
    )
    axes[0].set_title("Posición vs. tiempo")
    axes[0].set_xlabel("Tiempo, t (s)")
    axes[0].set_ylabel("Posición, x (m)")
    axes[0].grid(True, alpha=0.3)
    axes[0].legend()

    axes[1].plot(t, velocidad_t, color="crimson", linewidth=2.5)
    axes[1].axvline(
        tiempo_reaccion,
        color="darkorange",
        linestyle="--",
        label="Inicio del movimiento"
    )
    axes[1].set_title("Velocidad vs. tiempo")
    axes[1].set_xlabel("Tiempo, t (s)")
    axes[1].set_ylabel("Velocidad, v (m/s)")
    axes[1].grid(True, alpha=0.3)
    axes[1].legend()

    plt.tight_layout()
    plt.show()

distancia_widget = FloatSlider(
    value=120,
    min=5,
    max=500,
    step=5,
    description="Distancia (m)",
    continuous_update=False
)

reaccion_widget = FloatSlider(
    value=15,
    min=0,
    max=120,
    step=1,
    description="Reacción (s)",
    continuous_update=False
)

velocidad_widget = FloatSlider(
    value=1.2,
    min=0.1,
    max=5.0,
    step=0.1,
    description="Velocidad (m/s)",
    continuous_update=False
)

controles = VBox([
    distancia_widget,
    reaccion_widget,
    velocidad_widget
])

salida = interactive_output(
    simulacion,
    {
        "distancia": distancia_widget,
        "tiempo_reaccion": reaccion_widget,
        "velocidad": velocidad_widget
    }
)

display(Markdown("# Simulador de tiempo de respuesta mediante MRU"))
display(Markdown(
    "El modelo considera un tiempo de reacción seguido de un desplazamiento "
    "rectilíneo con velocidad constante."
))
display(controles, salida)